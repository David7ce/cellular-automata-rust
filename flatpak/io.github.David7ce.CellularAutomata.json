{
    "app-id": "io.github.David7ce.CellularAutomata",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "25.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-version": "25.08",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "cellular_automata",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin"
    },
    "modules": [
        {
            "name": "cellular-automata",
            "buildsystem": "simple",
            "build-commands": [
                "cargo build --release --offline",
                "install -Dm755 target/release/cellular_automata /app/bin/cellular_automata",
                "install -Dm644 packaging/linux/io.github.David7ce.CellularAutomata.desktop /app/share/applications/io.github.David7ce.CellularAutomata.desktop",
                "install -Dm644 packaging/icons/icon.png /app/share/icons/hicolor/256x256/apps/io.github.David7ce.CellularAutomata.png",
                "install -Dm644 flatpak/io.github.David7ce.CellularAutomata.metainfo.xml /app/share/metainfo/io.github.David7ce.CellularAutomata.metainfo.xml"
            ],
            "sources": [
                { "type": "dir", "path": ".." }
            ]
        }
    ]
}
