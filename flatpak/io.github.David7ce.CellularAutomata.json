{
  "app-id": "io.github.David7ce.CellularAutomata",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "cellular_automata",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "modules": [
    {
      "name": "cellular-automata",
      "buildsystem": "simple",
      "build-commands": [
        "cargo build --release --locked --offline",
        "install -Dm755 target/release/cellular_automata /app/bin/cellular_automata",
        "install -Dm644 io.github.David7ce.CellularAutomata.desktop /app/share/applications/io.github.David7ce.CellularAutomata.desktop",
        "install -Dm644 icon.png /app/share/icons/hicolor/256x256/apps/io.github.David7ce.CellularAutomata.png",
        "install -Dm644 io.github.David7ce.CellularAutomata.metainfo.xml /app/share/metainfo/io.github.David7ce.CellularAutomata.metainfo.xml"
      ],
      "sources": [
        { "type": "dir", "path": ".." }
      ]
    }
  ]
}
